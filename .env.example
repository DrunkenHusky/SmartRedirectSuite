# URL Migration Application - Environment Variables Example
# Copy this file to .env and update values as needed

# Admin Panel Authentication
# Default password for admin access (change this for production!)
ADMIN_PASSWORD=Password1

# Session Security
# Random string for secure session management (generate a strong random string with a minimum of 64 characters)
SESSION_SECRET=your-super-secret-session-key-here

# Brute-force Protection (optional)
# Max failed login attempts before blocking an IP
LOGIN_MAX_ATTEMPTS=5
# Block duration in milliseconds after reaching max attempts (24h)
LOGIN_BLOCK_DURATION_MS=86400000

# Server Configuration
# Port where the application will run
PORT=5000

# Environment Settings
# Set to 'production' for production deployment, 'development' for local development
NODE_ENV=production

# Logging Level (Optional)
# LOG_LEVEL=info

# File Upload Configuration
# Local file storage path for uploaded logo files
LOCAL_UPLOAD_PATH=./data/uploads

# Database Configuration
# sqlite is the default. Use postgres/postgresql, mariadb, or mysql for external databases.
DB_DIALECT=sqlite
# SQLite file path; ignored for external databases.
DB_STORAGE=./data/database.sqlite
# External database settings (PostgreSQL/MariaDB/MySQL).
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smartredirect
# DB_USER=redirectuser
# DB_PASSWORD=change-me
# DB_SSL=false
# DB_POOL_MAX=5
# DB_POOL_MIN=0
# DB_POOL_ACQUIRE_MS=30000
# DB_POOL_IDLE_MS=10000
