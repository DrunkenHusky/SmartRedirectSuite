NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://smartredirect:change-me@postgres:5432/smartredirect
DATABASE_SSL=false
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-at-least-12-characters
COOKIE_SECURE=false
TRUST_PROXY=1
ALLOWED_ORIGINS=

# Optional: generic OAuth 2.0 / OpenID Connect identity provider
# OAUTH_ISSUER_URL=https://identity.example.com/realms/company
# OAUTH_CLIENT_ID=smartredirect
# OAUTH_CLIENT_SECRET=replace-me
# OAUTH_REDIRECT_URI=https://redirect.example.com/api/admin/oauth/callback
# OAUTH_SCOPES=openid profile email
# OAUTH_ADMIN_GROUP=smartredirect-admins
# OAUTH_GROUPS_CLAIM=groups
